// Static site served by Cloudflare Workers (static assets only, no Worker script)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airupt-dev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "airupt.dev", "custom_domain": true }]
}
